# ==============================================================================
# Kumuta AI + Canvas Unified Deployment Configuration (.env.example)
# Copy this file to .env and supply your secrets. Never commit .env to Git.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Security & Authentication (Required)
# ------------------------------------------------------------------------------
# Random string of at least 32 characters used for signing user JWT sessions.
# Generate: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=replace_with_a_long_random_secret_at_least_32_characters

# Stable Fernet encryption key used to encrypt users' Gemini API keys in the database.
# Keep this secret stable. Changing it invalidates all previously saved API keys.
# For key rotation without losing existing saved keys, provide multiple keys separated by commas: new_key,old_key
# Generate: python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
API_KEY_ENCRYPTION_KEY=replace_with_a_fernet_key_base64_urlsafe

# ------------------------------------------------------------------------------
# 2. Origin & CORS Configuration
# ------------------------------------------------------------------------------
# For Render single-service deployments, the frontends and backend share the same
# origin, so requests are same-origin by default. You can also specify the public
# HTTPS URL of your Render service (e.g., https://your-service-name.onrender.com).
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# ------------------------------------------------------------------------------
# 3. Environment & Registration
# ------------------------------------------------------------------------------
# Mode: "development" allows self-registration for public demo testing.
# In "production" mode, registration is disabled by default for strict environments.
KUMUTA_ENV=development

# Optional registration toggle (true/false)
KUMUTA_ALLOW_REGISTRATION=true

# ------------------------------------------------------------------------------
# 4. Storage & Database Paths
# ------------------------------------------------------------------------------
# Absolute SQLite database URL. In Docker, this is configured to /data/db/chat.db.
DATABASE_URL=sqlite:////data/db/chat.db

# Absolute directory for uploaded and processed document attachments.
DOCUMENT_STORAGE_DIR=/data/documents

# Path where frontend production dist files are located.
FRONTEND_DIST=/app/frontend/dist

# ------------------------------------------------------------------------------
# 5. Model & Canvas Limits
# ------------------------------------------------------------------------------
# Users supply their own Gemini API key inside the UI (Bring Your Own Key - BYOK).
# Maximum Canvas generation jobs per rolling 24 hours per user (0 disables cap).
CANVAS_DAILY_JOBS=30

# Memory and Document Context Token Limits
MEMORY_CONTEXT_TOKENS=1200
DOCUMENT_CONTEXT_TOKENS=12000

# Enable restricted OpenUI Lang adapter for Canvas Engine B jobs
KUMUTA_OPENUI_ENABLED=true

# ------------------------------------------------------------------------------
# 6. Runtime Server Port
# ------------------------------------------------------------------------------
# Render automatically injects the PORT environment variable.
PORT=8000
